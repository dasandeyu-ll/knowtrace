# ===== 对话模型（必填）=====
# 兼容 OpenAI 协议的服务商，二选一：
#   DeepSeek : https://api.deepseek.com/v1   （推荐，性价比最高）
#   OpenAI   : https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 推荐 deepseek-chat；需要深度推理可换 deepseek-reasoner
CHAT_MODEL=deepseek-chat

# ===== 向量模型（无需 API Key，本地运行）=====
# DeepSeek 不提供 embedding 接口，故用本地 fastembed(ONNX) 模型
# 可选：BAAI/bge-small-zh-v1.5 (512维, 推荐) / BAAI/bge-base-zh-v1.5 (768维, 更准更慢)
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 模型下载源，国内建议保持镜像；海外可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ===== 可观测（可选）=====
# 设为 true 并填入 key，可在 LangSmith 看到完整调用链
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
